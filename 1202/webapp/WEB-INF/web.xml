<?xml version="1.0" encoding="UTF-8"?>
<web-app 
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">
   
    <servlet>
        <servlet-name>productAddAction</servlet-name>
        <jsp-file>/product_add_action.jsp</jsp-file>
        <multipart-config>
            <max-file-size>10485760</max-file-size> 
            <max-request-size>52428800</max-request-size> 
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>productAddAction</servlet-name>
        <url-pattern>/product_add_action.jsp</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>productEditAction</servlet-name>
        <jsp-file>/product_edit_action.jsp</jsp-file>
        <multipart-config>
            <max-file-size>10485760</max-file-size> 
            <max-request-size>52428800</max-request-size> 
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>productEditAction</servlet-name>
        <url-pattern>/product_edit_action.jsp</url-pattern>
    </servlet-mapping>
    
</web-app>